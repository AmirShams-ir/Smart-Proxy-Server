[Unit]
Description=Smart Proxy Reload
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/Smart-Proxy-Server

# Run the repository checkout directly so manual tests and systemd use the
# exact same script and configuration. Keep stdout/stderr attached to
# journald for a complete report.
ExecStart=/bin/bash /root/Smart-Proxy-Server/reload.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-proxy-reload

[Install]
WantedBy=multi-user.target

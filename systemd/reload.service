[Unit]
Description=Smart Proxy Server Full Rebuild
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/Smart-Proxy-Server
ExecStart=/bin/bash /root/Smart-Proxy-Server/reload.sh
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-proxy-reload

[Install]
WantedBy=multi-user.target

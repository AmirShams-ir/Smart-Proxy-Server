[Unit]
Description=Smart Proxy Reload
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
WorkingDirectory=/opt/smart-proxy

ExecStart=/usr/bin/stdbuf -oL -eL /bin/bash /opt/smart-proxy/reload.sh

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
[Unit]
Description=Smart Proxy Reload
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/smart-proxy

# Send the report to the journal through a dedicated logger. This avoids
# losing stdout produced by the nested bash/report pipeline.
ExecStart=/opt/smart-proxy/reload.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-proxy-reload

[Install]
WantedBy=multi-user.target

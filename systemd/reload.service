[Unit]
Description=Smart Proxy Reload
After=network-online.target sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/smart-proxy

# Execute through bash and pipe stdout/stderr directly into journald.
ExecStart=/bin/bash -c '/opt/smart-proxy/reload.sh 2>&1 | /usr/bin/systemd-cat -t smart-proxy-reload'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smart-proxy-reload

[Install]
WantedBy=multi-user.target
